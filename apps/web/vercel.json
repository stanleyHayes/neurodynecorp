{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "npx --yes pnpm@11.20.0 install --frozen-lockfile",
  "trailingSlash": false,
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/projects",
      "destination": "/products",
      "permanent": true
    },
    {
      "source": "/projects/:slug",
      "destination": "/products/:slug",
      "permanent": true
    },
    {
      "source": "/solutions",
      "destination": "/infrastructure",
      "permanent": true
    },
    {
      "source": "/open-standards",
      "destination": "/infrastructure",
      "permanent": true
    },
    {
      "source": "/philosophy",
      "destination": "/vision",
      "permanent": true
    },
    {
      "source": "/industries",
      "destination": "/infrastructure",
      "permanent": true
    },
    {
      "source": "/industries/:slug",
      "destination": "/infrastructure",
      "permanent": true
    },
    {
      "source": "/press",
      "destination": "/about",
      "permanent": true
    },
    {
      "source": "/subsidiaries",
      "destination": "/about",
      "permanent": true
    },
    {
      "source": "/services",
      "destination": "/company/engineering-services",
      "permanent": true
    },
    {
      "source": "/services/:slug",
      "destination": "/company/engineering-services/:slug",
      "permanent": true
    },
    {
      "source": "/start-project",
      "destination": "/company/engineering-services/brief",
      "permanent": true
    },
    {
      "source": "/diagnostic",
      "destination": "/company/engineering-services/diagnostic",
      "permanent": true
    },
    {
      "source": "/estimator",
      "destination": "/company/engineering-services/estimator",
      "permanent": true
    },
    {
      "source": "/rfp",
      "destination": "/company/engineering-services/rfp",
      "permanent": true
    },
    {
      "source": "/spec-library",
      "destination": "/company/engineering-services/spec-library",
      "permanent": true
    },
    {
      "source": "/portfolio",
      "destination": "/company/engineering-services/work",
      "permanent": true
    },
    {
      "source": "/portfolio/:slug",
      "destination": "/company/engineering-services/work/:slug",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/app-shell.html"
    }
  ],
  "headers": [
    {
      "source": "/sitemap.xml",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/xml"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-XSS-Protection",
          "value": "1; mode=block"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        }
      ]
    },
    {
      "source": "/og-image.jpg",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400"
        }
      ]
    }
  ]
}
