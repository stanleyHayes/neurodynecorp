# Public-facing site
# Backend API origin (no trailing slash). Defaults to http://localhost:4000 in dev.
VITE_API_URL=https://api.neurodyne.dev

# Optional: full canonical site URL used in <link rel="canonical"> and SEO meta.
# Falls back to "https://neurodyne.dev" when unset.
VITE_SITE_URL=https://neurodyne.dev
VITE_CLIENT_PORTAL_URL=https://client.neurodyne.dev
