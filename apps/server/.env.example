# ── Server ──
NEURODYNE_PORT=4000
NEURODYNE_HOST=0.0.0.0
NEURODYNE_ENV=development
NEURODYNE_CORS_ORIGINS=http://localhost:3000,http://localhost:5173
# Production: https://neurodyne.dev,https://client.neurodyne.dev,https://admin.neurodyne.dev

# ── MongoDB ──
NEURODYNE_MONGODB_URI=mongodb://localhost:27017
NEURODYNE_MONGODB_DATABASE=neurodyne

# ── Redis ──
NEURODYNE_REDIS_URL=
NEURODYNE_REDIS_HOST=localhost
NEURODYNE_REDIS_PORT=6379
NEURODYNE_REDIS_PASSWORD=

# ── Kafka ──
NEURODYNE_KAFKA_BROKERS=localhost:9092
NEURODYNE_KAFKA_CLIENT_ID=neurodyne-server
NEURODYNE_KAFKA_GROUP_ID=neurodyne-group

# ── JWT ──
NEURODYNE_JWT_ACCESS_SECRET=change-me-access-secret
NEURODYNE_JWT_REFRESH_SECRET=change-me-refresh-secret
NEURODYNE_JWT_ACCESS_EXPIRES=15m
NEURODYNE_JWT_REFRESH_EXPIRES=7d

# ── Cloudinary ──
NEURODYNE_CLOUDINARY_CLOUD_NAME=
NEURODYNE_CLOUDINARY_API_KEY=
NEURODYNE_CLOUDINARY_API_SECRET=

# ── Email (Resend) ──
NEURODYNE_RESEND_API_KEY=
NEURODYNE_EMAIL_FROM=noreply@neurodynecorp.com
# Portal origin used in password-reset emails (no trailing slash)
NEURODYNE_PASSWORD_RESET_BASE_URL=http://localhost:5173

# Optional project-intake copilot (server-side only)
OPENAI_API_KEY=
OPENAI_INTAKE_MODEL=gpt-5-mini
NEURODYNE_PROJECT_INTAKE_NOTIFY_TO=projects@neurodynecorp.com

# ── Payments (set provider to "stripe" or "paystack") ──
NEURODYNE_PAYMENT_PROVIDER=paystack

NEURODYNE_STRIPE_SECRET_KEY=
NEURODYNE_STRIPE_WEBHOOK_SECRET=

NEURODYNE_PAYSTACK_SECRET_KEY=
NEURODYNE_PAYSTACK_WEBHOOK_SECRET=

# ── Metrics ──
NEURODYNE_METRICS_ENABLED=true
NEURODYNE_METRICS_PORT=9090

# ── Public site (used by /feed.xml and /sitemap.xml) ──
NEURODYNE_SITE_URL=https://neurodyne.dev
